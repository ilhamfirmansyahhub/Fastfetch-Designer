{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "width": 48,
    "height": 29,
    "padding": {
      "left": 0,
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "#D8DEE9",
      "title": "#8FBCBB",
      "output": "#D8DEE9",
      "separator": "#81A1C1"
    },
    "brightColor": true
  },
  "modules": [
    "os", "kernel", "uptime", "display", "de", "wm", "terminal",
    "cpu", "gpu", "memory", "disk"
  ]
}
